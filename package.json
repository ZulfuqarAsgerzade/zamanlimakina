{
  "name": "zamanli-makina",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node --env-file-if-exists=.env scripts/prerender.ts",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src scripts netlify",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo:install": "node --env-file-if-exists=.env scripts/demo.ts install",
    "demo:remove": "node --env-file-if-exists=.env scripts/demo.ts remove",
    "demo:art": "node scripts/generate-demo-art.ts",
    "serve:dist": "node scripts/serve-dist.ts",
    "test:sql": "node scripts/test-sql.ts",
    "fake:supabase": "node scripts/fake-supabase.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
