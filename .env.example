# ───────────────────────── Zamanlı Makina — environment variables ─────────────────────────
# Copy to .env (never commit .env). Without the Supabase pair below the site runs in LOCAL DEMO MODE:
# demo catalogue + a working admin panel whose data lives only in the visiting browser (IndexedDB).

# ── Production backend (Supabase) — PUBLIC values, safe in the browser ──
# Supabase dashboard → Project Settings → API. The anon key is public by design; Row-Level Security protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Force local demo mode even if the two values above are set (useful for screenshots / QA)
# VITE_DATA_MODE=demo

# Canonical site origin for canonical / hreflang / sitemap / robots (default: https://zamanlimakina.az)
# SITE_URL=https://staging.example.com

# Staging ONLY: lets the admin panel of a Supabase-connected build install demo data. A production-context build refuses it.
# VITE_ALLOW_DEMO_TOOLS=false

# ── Server-side only (NEVER prefix with VITE_, never expose to the browser) ──
# Used by `npm run demo:install` / `demo:remove` and nowhere else. Both also need --yes --confirm-host=<host>;
# install additionally needs ALLOW_DEMO_TOOLS=true (leave unset for a production project).
SUPABASE_SERVICE_ROLE_KEY=
# ALLOW_DEMO_TOOLS=true

# ── Netlify Functions (set in Netlify → Site settings → Environment variables) ──
# The dynamic /sitemap.xml function reads published, non-demo rows with the anon key.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
