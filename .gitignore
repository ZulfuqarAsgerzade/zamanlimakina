# Asılılıqlar və build nəticəsi
node_modules
dist
dist-ssr

# Mühit faylları (yalnız .env.example saxlanılır)
.env
.env.*
!.env.example
*.local

# TypeScript / alətlər
tsconfig.tsbuildinfo
.vite
coverage

# Jurnallar
*.log
npm-debug.log*

